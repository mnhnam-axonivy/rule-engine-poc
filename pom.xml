<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.axonivy.utils.ruleengine</groupId>
  <artifactId>rule-engine-modules</artifactId>
  <version>14.0.1-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Axon Ivy Rules Engine</name>

  <modules>
    <!-- decision runtime: Quarkus service with the DMN engine and its database, shipped as container image -->
    <module>rule-engine-runtime</module>
    <!-- Ivy connector: Business Rule Task, versions, client of the DMN engine container, DMN editor, DMN generator -->
    <module>rule-engine</module>
    <module>rule-engine-demo</module>
    <module>rule-engine-test</module>
    <module>rule-engine-product</module>
    <module>rule-engine-doc</module>
    <!-- Axon Ivy Portal, built from source alongside the rules projects -->
    <module>portal-components</module>
    <module>portal</module>
  </modules>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <artifactId>maven-deploy-plugin</artifactId>
          <version>3.2.0</version>
          <configuration>
            <skip>true</skip>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-release-plugin</artifactId>
          <version>3.3.1</version>
          <configuration>
            <tagNameFormat>v@{project.version}</tagNameFormat>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
