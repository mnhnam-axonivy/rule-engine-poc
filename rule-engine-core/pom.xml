<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.axonivy.ivy.api</groupId>
    <artifactId>ivy-project-parent</artifactId>
    <version>14.0.1</version>
    <relativePath />
  </parent>
  <groupId>com.axonivy.utils.ruleengine</groupId>
  <artifactId>rule-engine-core</artifactId>
  <version>14.0.1-SNAPSHOT</version>
  <packaging>iar</packaging>
  <name>Axon Ivy Rules Engine - core</name>
  <!--
    What the Ivy connector (rule-engine) and the decision runtime (rule-engine-runtime) share:
      com.axonivy.utils.rule.engine.api            the API of the decision runtime: requests, responses, statuses
      com.axonivy.utils.rule.engine.dmn.generator  generates a .dmn file from the fields of a data class

    Plain Java only. The decision runtime compiles these sources into its own build (Java 21, without any
    Axon Ivy API), so code that uses ch.ivyteam.* or a newer Java version breaks the runtime build.
  -->
  <dependencies>
    <dependency>
      <!-- provides the Jackson annotations of the API records -->
      <groupId>com.axonivy.ivy.api</groupId>
      <artifactId>ivy-api</artifactId>
    </dependency>
    <dependency>
      <!-- documentation of the API records for the OpenAPI contract of the runtime; only read by the runtime -->
      <groupId>org.eclipse.microprofile.openapi</groupId>
      <artifactId>microprofile-openapi-api</artifactId>
      <version>4.1.1</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>
  <repositories>
    <repository>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
      <id>central</id>
      <url>https://repo.maven.apache.org/maven2</url>
    </repository>
    <repository>
      <id>maven.axonivy.com</id>
      <url>https://maven.axonivy.com</url>
    </repository>
  </repositories>
  <pluginRepositories>
    <pluginRepository>
      <id>maven.axonivy.com</id>
      <url>https://maven.axonivy.com</url>
    </pluginRepository>
  </pluginRepositories>
  <build>
    <plugins>
      <plugin>
        <groupId>com.axonivy.ivy.ci</groupId>
        <artifactId>project-build-plugin</artifactId>
        <version>14.0.1</version>
      </plugin>
    </plugins>
  </build>
</project>
