{
  "$schema": "https://json-schema.axonivy.com/14.0/project/data-class.json",
  "simpleName": "Invoice",
  "namespace": "com.axonivy.utils.rule.engine.demo",
  "fields": [
    {
      "name": "number"
    },
    {
      "name": "amount",
      "type": "Number"
    },
    {
      "name": "costCenter"
    },
    {
      "name": "supplierRating",
      "comment": "A, B or C"
    },
    {
      "name": "hasPurchaseOrder",
      "type": "java.lang.Boolean"
    },
    {
      "name": "invoiceDate",
      "type": "Date"
    },
    {
      "name": "items",
      "type": "List<com.axonivy.utils.rule.engine.demo.InvoiceItem>"
    }
  ]
}
