      "name": "product"
    },
    {
      "name": "category",
      "comment": "Hardware, Software, Services, Consumables or Books"
    },
    {
      "name": "quantity",
      "type": "java.lang.Integer"
    },
    {
      "name": "unitPrice",
      "type": "java.math.BigDecimal"
    }
  ]
}
