{
  "$schema": "https://json-schema.axonivy.com/14.0/project/data-class.json",
  "simpleName": "InvoiceLine",
  "namespace": "com.axonivy.utils.rule.engine.demo",
  "comment": "A line of an invoice.",
  "fields": [
    {
      "name": "product"
    },
    {
      "name": "quantity",
      "type": "java.lang.Integer"
    },
    {
      "name": "unitPrice",
      "type": "java.math.BigDecimal"
    },
    {
      "name": "amount",
      "type": "java.math.BigDecimal",
      "comment": "Quantity times unit price"
    }
  ]
}
