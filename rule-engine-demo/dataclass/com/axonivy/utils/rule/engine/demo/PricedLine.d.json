{
  "$schema": "https://json-schema.axonivy.com/14.0/project/data-class.json",
  "simpleName": "PricedLine",
  "namespace": "com.axonivy.utils.rule.engine.demo",
  "comment": "A line priced by the decision pricedLines.",
  "fields": [
    {
      "name": "product"
    },
    {
      "name": "category"
    },
    {
      "name": "quantity",
      "type": "java.lang.Integer"
    },
    {
      "name": "unitPrice",
      "type": "java.math.BigDecimal"
    },
    {
      "name": "gross",
      "type": "java.math.BigDecimal",
      "comment": "quantity * unitPrice"
    },
    {
      "name": "discountPercent",
      "type": "java.math.BigDecimal",
      "comment": "From the table lineDiscountTable"
    },
    {
      "name": "discountReason"
    },
    {
      "name": "discounted",
      "type": "java.math.BigDecimal",
      "comment": "After the line discount"
    },
    {
      "name": "orderDiscount",
      "type": "java.math.BigDecimal",
      "comment": "The share of the order discount"
    },
    {
      "name": "net",
      "type": "java.math.BigDecimal",
      "comment": "The amount the VAT is calculated on"
    },
    {
      "name": "vatRate",
      "type": "java.math.BigDecimal",
      "comment": "From the table vatRateTable"
    },
    {
      "name": "vat",
      "type": "java.math.BigDecimal",
      "comment": "From the formula taxFormula"
    },
    {
      "name": "total",
      "type": "java.math.BigDecimal"
    }
  ]
}
