{
  "$schema": "https://json-schema.axonivy.com/14.0/project/data-class.json",
  "simpleName": "SalesInvoice",
  "namespace": "com.axonivy.utils.rule.engine.demo",
  "comment": "A sales invoice: the header and its lines. The fields named like the inputs of dmn/invoice-pricing.dmn are read by the Business Rule Task.",
  "fields": [
    {
      "name": "number"
    },
    {
      "name": "customer",
      "comment": "Name of the customer. The rules do not read it yet: a rule owner may add it as input in the Portal."
    },
    {
      "name": "customerTier",
      "comment": "Standard, Silver, Gold or Platinum"
    },
    {
      "name": "country",
      "comment": "CH, DE, FR or AT"
    },
    {
      "name": "paymentTerms",
      "comment": "Prepaid, Net 30 or Net 60"
    },
    {
      "name": "promoCode"
    },
    {
      "name": "expressDelivery",
      "type": "java.lang.Boolean"
    },
    {
      "name": "invoiceDate",
      "type": "java.time.LocalDate"
    },
    {
      "name": "lines",
      "type": "List<com.axonivy.utils.rule.engine.demo.InvoiceLine>"
    }
  ]
}
