{
  "$schema" : "https://json-schema.axonivy.com/14.0/project/process.json",
  "id" : "19A8D1C0FFEE0002",
  "config" : {
    "data" : "com.axonivy.utils.rule.engine.demo.ApprovalDemoData"
  },
  "elements" : [ {
      "id" : "f0",
      "type" : "RequestStart",
      "name" : "approval",
      "config" : {
        "signature" : "approval",
        "request" : {
          "name" : "Rule Engine Demo: invoice approval",
          "description" : "Evaluates all decisions of dmn/invoice-approval.dmn: risk level, approval route and due date."
        }
      },
      "visual" : {
        "at" : { "x" : 96, "y" : 64 }
      },
      "connect" : [
        { "id" : "f1", "to" : "f2" }
      ]
    }, {
      "id" : "f2",
      "type" : "Script",
      "name" : "Large invoice without purchase order",
      "config" : {
        "output" : {
          "code" : [
            "import com.axonivy.utils.rule.engine.demo.InvoiceItem;",
            "",
            "in.invoice.number = \"INV-2026-0815\";",
            "in.invoice.amount = 25000;",
            "in.invoice.costCenter = \"IT\";",
            "in.invoice.supplierRating = \"B\";",
            "in.invoice.hasPurchaseOrder = false;",
            "in.invoice.invoiceDate = new Date(2026, 11, 15);",
            "InvoiceItem item = new InvoiceItem();",
            "item.article = \"Server rack\";",
            "item.quantity = 2;",
            "item.price = 12500;",
            "in.invoice.items.add(item);"
          ]
        }
      },
      "visual" : {
        "at" : { "x" : 240, "y" : 64 },
        "size" : { "width" : 160, "height" : 60 }
      },
      "connect" : [
        { "id" : "f3", "to" : "f4" }
      ]
    }, {
      "id" : "f4",
      "type" : "ProgramInterface",
      "name" : [
        "Business Rule Task",
        "invoice approval"
      ],
      "config" : {
        "javaClass" : "com.axonivy.utils.rule.engine.BusinessRuleTask",
        "userConfig" : {
          "decision" : "invoice-approval"
        }
      },
      "visual" : {
        "at" : { "x" : 432, "y" : 64 },
        "size" : { "width" : 144, "height" : 60 }
      },
      "boundaries" : [ {
          "id" : "f8",
          "type" : "ErrorBoundaryEvent",
          "name" : "rule:engine",
          "config" : {
            "errorCode" : "rule:engine",
            "output" : {
              "code" : [
                "in.errorCode = error.getErrorCode();",
                "in.errorMessage = error.getMessage();",
                "ivy.log.error(\"The approval cannot be decided: \" + error.getMessage());"
              ]
            }
          },
          "visual" : {
            "at" : { "x" : 472, "y" : 96 }
          },
          "connect" : [
            { "id" : "f9", "to" : "f10", "via" : [ { "x" : 472, "y" : 168 } ] }
          ]
        } ],
      "connect" : [
        { "id" : "f5", "to" : "f6" }
      ]
    }, {
      "id" : "f6",
      "type" : "Script",
      "name" : "Log approval",
      "config" : {
        "output" : {
          "code" : [
            "ivy.log.info(\"Invoice \" + in.invoice.number + \": risk \" + in.riskLevel + \", \" + in.approval.nextStep + \", four eyes \" + in.approval.fourEyes + \", due \" + in.dueDate);"
          ]
        }
      },
      "visual" : {
        "at" : { "x" : 616, "y" : 64 }
      },
      "connect" : [
        { "id" : "f7", "to" : "f11" }
      ]
    }, {
      "id" : "f11",
      "type" : "TaskEnd",
      "visual" : {
        "at" : { "x" : 752, "y" : 64 }
      }
    }, {
      "id" : "f10",
      "type" : "TaskEnd",
      "name" : "not decided",
      "visual" : {
        "at" : { "x" : 616, "y" : 168 }
      }
    }, {
      "id" : "f30",
      "type" : "ProcessAnnotation",
      "name" : [
        "The whole model is evaluated. Every decision is mapped by name:",
        "riskLevel goes to in.riskLevel, dueDate to in.dueDate,",
        "the structure 'approval' fills the data class in.approval."
      ],
      "visual" : {
        "at" : { "x" : 432, "y" : 232 },
        "size" : { "width" : 400, "height" : 60 }
      }
    } ]
}
