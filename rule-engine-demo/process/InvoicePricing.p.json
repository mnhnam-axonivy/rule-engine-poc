{
  "$schema" : "https://json-schema.axonivy.com/14.0/project/process.json",
  "id" : "FAE97A22A36BA382",
  "kind" : "CALLABLE_SUB",
  "config" : {
    "data" : "com.axonivy.utils.rule.engine.demo.InvoicePricingData"
  },
  "elements" : [ {
      "id" : "f0",
      "type" : "CallSubStart",
      "name" : "price(Invoice)",
      "config" : {
        "signature" : "price",
        "input" : {
          "params" : [
            { "name" : "invoice", "type" : "com.axonivy.utils.rule.engine.demo.Invoice", "desc" : "The invoice with its lines and the customer tier" }
          ],
          "map" : {
            "out.invoice" : "param.invoice"
          }
        },
        "result" : {
          "params" : [
            { "name" : "invoice", "type" : "com.axonivy.utils.rule.engine.demo.Invoice", "desc" : "The invoice with its amounts, discount and total" },
            { "name" : "errorCode", "type" : "String", "desc" : "Set if the rules could not decide" },
            { "name" : "errorMessage", "type" : "String", "desc" : "Why the rules could not decide" }
          ],
          "map" : {
            "result.invoice" : "in.invoice",
            "result.errorCode" : "in.errorCode",
            "result.errorMessage" : "in.errorMessage"
          }
        }
      },
      "visual" : {
        "at" : { "x" : 96, "y" : 64 },
        "labelOffset" : { "x" : 13, "y" : 37 }
      },
      "connect" : [
        { "id" : "f1", "to" : "f2" }
      ]
    }, {
      "id" : "f2",
      "type" : "Script",
      "name" : "Sum the lines",
      "config" : {
        "output" : {
          "code" : [
            "import com.axonivy.utils.rule.engine.demo.InvoiceLine;",
            "",
            "BigDecimal orderAmount = BigDecimal.ZERO;",
            "for (InvoiceLine line : in.invoice.lines) {",
            "  line.amount = line.unitPrice.multiply(BigDecimal.valueOf(line.quantity.longValue()));",
            "  orderAmount = orderAmount.add(line.amount);",
            "}",
            "in.invoice.orderAmount = orderAmount;"
          ]
        }
      },
      "visual" : {
        "at" : { "x" : 240, "y" : 64 }
      },
      "connect" : [
        { "id" : "f3", "to" : "f4" }
      ]
    }, {
      "id" : "f4",
      "type" : "ProgramInterface",
      "name" : [
        "Business Rule Task",
        "invoice-discount"
      ],
      "config" : {
        "javaClass" : "com.axonivy.utils.rule.engine.BusinessRuleTask",
        "userConfig" : {
          "decision" : "invoice-discount#discount",
          "decision[invoice-discount#discount].input.customerTier" : "in.invoice.customerTier",
          "decision[invoice-discount#discount].input.orderAmount" : "in.invoice.orderAmount",
          "decision[invoice-discount#discount].output.discountPercent" : "in.invoice.discountPercent",
          "decision[invoice-discount#discount].output.discountReason" : "in.invoice.discountReason"
        }
      },
      "visual" : {
        "at" : { "x" : 400, "y" : 64 },
        "size" : { "width" : 144, "height" : 60 }
      },
      "boundaries" : [ {
          "id" : "f8",
          "type" : "ErrorBoundaryEvent",
          "name" : "rule:engine",
          "config" : {
            "errorCode" : "rule:engine",
            "output" : {
              "code" : [
                "in.errorCode = error.getErrorCode();",
                "in.errorMessage = error.getMessage();",
                "ivy.log.error(\"The invoice cannot be priced: \" + error.getMessage());"
              ]
            }
          },
          "visual" : {
            "at" : { "x" : 440, "y" : 96 }
          },
          "connect" : [
            { "id" : "f9", "to" : "f10", "via" : [ { "x" : 440, "y" : 168 } ] }
          ]
        } ],
      "connect" : [
        { "id" : "f5", "to" : "f6" }
      ]
    }, {
      "id" : "f6",
      "type" : "Script",
      "name" : "Apply the discount",
      "config" : {
        "output" : {
          "code" : [
            "import java.math.RoundingMode;",
            "",
            "in.invoice.discountAmount = in.invoice.orderAmount.multiply(in.invoice.discountPercent).movePointLeft(2).setScale(2, RoundingMode.HALF_UP);",
            "in.invoice.total = in.invoice.orderAmount.subtract(in.invoice.discountAmount);",
            "ivy.log.info(\"Invoice \" + in.invoice.number + \": \" + in.invoice.discountPercent + \"% (\" + in.invoice.discountReason + \"), total \" + in.invoice.total);"
          ]
        }
      },
      "visual" : {
        "at" : { "x" : 560, "y" : 64 }
      },
      "connect" : [
        { "id" : "f7", "to" : "f11" }
      ]
    }, {
      "id" : "f11",
      "type" : "CallSubEnd",
      "visual" : {
        "at" : { "x" : 704, "y" : 64 }
      }
    }, {
      "id" : "f10",
      "type" : "CallSubEnd",
      "name" : "not priced",
      "visual" : {
        "at" : { "x" : 560, "y" : 168 }
      }
    }, {
      "id" : "f30",
      "type" : "ProcessAnnotation",
      "name" : [
        "The Business Rule Task reads customerTier and orderAmount from in.invoice by name.",
        "The decision discount answers discountPercent and discountReason,",
        "which are written back to in.invoice by name."
      ],
      "visual" : {
        "at" : { "x" : 400, "y" : 248 },
        "size" : { "width" : 480, "height" : 60 }
      }
    } ]
}
