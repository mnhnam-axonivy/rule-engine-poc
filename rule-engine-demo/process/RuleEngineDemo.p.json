        "output" : {
          "code" : [
            "in.member.customerId = \"C-1001\";",
            "in.member.type = \"Gold\";",
            "in.member.country = \"CH\";",
            "in.member.purchaseAmount = 1500;"
          ]
        }
      },
      "visual" : {
