                "in.errorCode = error.getErrorCode();",
                "in.errorMessage = error.getMessage();",
                "ivy.log.error(\"The discount cannot be decided: \" + error.getMessage());"
              ]
            }
          },
          "visual" : {
            "at" : { "x" : 456, "y" : 96 }
