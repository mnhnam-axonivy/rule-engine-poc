<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.axonivy.ivy.api</groupId>
    <artifactId>ivy-project-parent</artifactId>
    <version>14.0.1</version>
    <relativePath />
  </parent>
  <groupId>com.axonivy.utils.ruleengine</groupId>
  <artifactId>rule-engine-doc</artifactId>
  <version>14.0.1-SNAPSHOT</version>
  <packaging>iar</packaging>
  <name>Axon Ivy Rules Engine: tutorial and walkthroughs</name>
  <dependencies>
    <dependency>
      <groupId>com.axonivy.ivy.api</groupId>
      <artifactId>ivy-api</artifactId>
    </dependency>
    <dependency>
      <groupId>com.axonivy.ivy.api.test</groupId>
      <artifactId>ivy-test-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- the tutorial explains the demo project and runs next to it; built by the repository: mvn install -pl rule-engine-demo -am -->
    <dependency>
      <groupId>com.axonivy.utils.ruleengine</groupId>
      <artifactId>rule-engine-demo</artifactId>
      <version>${project.version}</version>
      <type>iar</type>
    </dependency>
  </dependencies>
  <repositories>
    <repository>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
      <id>central</id>
      <url>https://repo.maven.apache.org/maven2</url>
    </repository>
    <repository>
      <id>maven.axonivy.com</id>
      <url>https://maven.axonivy.com</url>
    </repository>
  </repositories>
  <pluginRepositories>
    <pluginRepository>
      <id>maven.axonivy.com</id>
      <url>https://maven.axonivy.com</url>
    </pluginRepository>
  </pluginRepositories>
  <build>
    <testSourceDirectory>src_test</testSourceDirectory>
    <plugins>
      <plugin>
        <groupId>com.axonivy.ivy.ci</groupId>
        <artifactId>project-build-plugin</artifactId>
        <version>14.0.1</version>
        <configuration>
          <iarExcludes>
            <!-- the sources of the walkthroughs (Node.js) and the requirements: not part of the project -->
            <iarExclude>internal/**</iarExclude>
            <iarExclude>doc/**</iarExclude>
          </iarExcludes>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <!-- mvn verify -Pweb.test: starts an Axon Ivy Engine of its own, deploys the projects to it
           and runs the *WebIT classes against it over HTTP -->
      <id>web.test</id>
      <build>
        <plugins>
          <plugin>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <skip>true</skip>
            </configuration>
          </plugin>
          <plugin>
            <groupId>com.axonivy.ivy.ci</groupId>
            <artifactId>project-build-plugin</artifactId>
            <version>14.0.1</version>
            <executions>
              <execution>
                <id>start.test.engine</id>
                <phase>pre-integration-test</phase>
                <goals>
                  <goal>start-test-engine</goal>
                  <goal>deploy-to-test-engine</goal>
                </goals>
              </execution>
              <execution>
                <id>test.engine.properties</id>
                <phase>integration-test</phase>
                <goals>
                  <goal>ivy-integration-test-properties</goal>
                </goals>
              </execution>
              <execution>
                <id>stop.test.engine</id>
                <phase>post-integration-test</phase>
                <goals>
                  <goal>stop-test-engine</goal>
                </goals>
                <configuration>
                  <!-- Java 25 warns about native access on the console. The plugin reads the state of the
                       engine from that output and would not recognise that the engine has stopped. -->
                  <additionalVmOptions>--enable-native-access=ALL-UNNAMED</additionalVmOptions>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <artifactId>maven-failsafe-plugin</artifactId>
            <executions>
              <execution>
                <id>integration-test</id>
                <goals>
                  <goal>integration-test</goal>
                </goals>
              </execution>
              <execution>
                <id>verify</id>
                <goals>
                  <goal>verify</goal>
                </goals>
              </execution>
            </executions>
            <configuration>
              <includes>
                <include>**/*WebIT.java</include>
              </includes>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
