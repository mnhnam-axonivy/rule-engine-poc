{
  "$schema": "https://json-schema.axonivy.com/market/14.0.0/product.json",
  "minimumIvyVersion": "14.0.0",
  "installers": [
    {
      "id": "maven-import",
      "data": {
        "projects": [
          {
            "groupId": "com.axonivy.utils.ruleengine",
            "artifactId": "rule-engine-demo",
            "version": "${version}",
            "type": "iar"
          },
          {
            "groupId": "com.axonivy.utils.ruleengine",
            "artifactId": "rule-engine-editor",
            "version": "${version}",
            "type": "iar"
          }
        ],
        "repositories": [
          {
            "id": "maven.axonivy.com",
            "url": "https://maven.axonivy.com",
            "snapshots": {
              "enabled": "true"
            }
          }
        ]
      }
    },
    {
      "id": "maven-dependency",
      "data": {
        "dependencies": [
          {
            "groupId": "com.axonivy.utils.ruleengine",
            "artifactId": "rule-engine",
            "version": "${version}",
            "type": "iar"
          }
        ],
        "repositories": [
          {
            "id": "maven.axonivy.com",
            "url": "https://maven.axonivy.com",
            "snapshots": {
              "enabled": "true"
            }
          }
        ]
      }
    }
  ]
}
