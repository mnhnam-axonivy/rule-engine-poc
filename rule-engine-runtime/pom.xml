<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.axonivy.utils.ruleengine</groupId>
  <artifactId>rule-engine-runtime</artifactId>
  <version>14.0.1-SNAPSHOT</version>
  <name>Axon Ivy Rules Engine - decision runtime</name>
  <description>Generic decision runtime that evaluates DMN models loaded at runtime. Based on Quarkus and the DMN engine of Apache KIE (Drools, Kogito).</description>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <quarkus.platform.version>3.38.1</quarkus.platform.version>
    <!-- Apache KIE release. 10.2.0 reads DMN 1.1 up to 1.6, which is what the KIE DMN editor writes. -->
    <kie.version>10.2.0</kie.version>
    <compiler-plugin.version>3.14.0</compiler-plugin.version>
    <surefire-plugin.version>3.5.3</surefire-plugin.version>
    <!-- The Ivy connector, the project next to this one. Only the tests compile two of its packages: its API
         records (ContractTest) and its DMN generator (GeneratedDmnTest). The runtime and its image contain neither,
         so the Docker build needs nothing but this folder. -->
    <connector.sources>${project.basedir}/../rule-engine/src</connector.sources>
    <skipITs>true</skipITs>
    <!-- DMN editor of the page /editor/: the standalone build of the Apache KIE DMN editor, same KIE release as
         the engine. Not on Maven Central, so the build takes it from npm, checks it and keeps it in the local
         Maven repository. -->
    <dmn.editor.version>10.2.0</dmn.editor.version>
    <dmn.editor.sha512>074a68624f010ac3a7f67e8dd0313dc79e9bd8b2f47f814bb26ace7f9f77974e99339e070e8ce0e4458472104cbe291e86ab4e94cbb915de9fe3fbb5c5e73884</dmn.editor.sha512>
    <dmn.editor.file>dmn-editor-standalone-${dmn.editor.version}.tgz</dmn.editor.file>
    <dmn.editor.url>https://registry.npmjs.org/@kie-tools/dmn-editor-standalone/-/${dmn.editor.file}</dmn.editor.url>
    <dmn.editor.cache>${settings.localRepository}/.cache/kie-tools</dmn.editor.cache>
    <!-- mvn install: builds the image from target/docker, removes the container even if it runs, and runs the new
         image in its place (executions docker-*). Nothing is lost: the Ivy application stores the versions and loads
         them into the new container. -Ddocker.skip=true: none of it, e.g. on a machine without Docker. -->
    <docker.skip>false</docker.skip>
    <docker.image>axonivy/rule-engine-runtime:dev</docker.image>
    <docker.container>axonivy-rule-engine</docker.container>
    <docker.port>8090</docker.port>
    <!-- RULE_ENGINE_API_KEY of the container; empty: the API is open, for your machine only -->
    <docker.api-key></docker.api-key>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.quarkus.platform</groupId>
        <artifactId>quarkus-bom</artifactId>
        <version>${quarkus.platform.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest-jackson</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-smallrye-health</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-smallrye-openapi</artifactId>
    </dependency>

    <dependency>
      <groupId>org.kie</groupId>
      <artifactId>kie-dmn-core</artifactId>
      <version>${kie.version}</version>
    </dependency>
    <dependency>
      <groupId>org.kie</groupId>
      <artifactId>kie-dmn-validation</artifactId>
      <version>${kie.version}</version>
    </dependency>

    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit5</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.rest-assured</groupId>
      <artifactId>rest-assured</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>3.27.3</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>io.quarkus.platform</groupId>
        <artifactId>quarkus-maven-plugin</artifactId>
        <version>${quarkus.platform.version}</version>
        <extensions>true</extensions>
        <executions>
          <execution>
            <goals>
              <goal>build</goal>
              <goal>generate-code</goal>
              <goal>generate-code-tests</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <!-- target/docker: the build context of the image, `docker build target/docker`. The Dockerfile of
             src/main/docker, LICENSE, NOTICE and the application. Runs after the build of Quarkus, which is declared
             above it and bound to the same phase. Quarkus keeps writing to target/quarkus-app: with its output
             directory moved, it would also put the OpenAPI files into the context. -->
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.3.1</version>
        <executions>
          <execution>
            <id>docker-context</id>
            <phase>package</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/docker</outputDirectory>
              <resources>
                <resource>
                  <directory>src/main/docker</directory>
                </resource>
                <resource>
                  <directory>${project.basedir}</directory>
                  <includes>
                    <include>LICENSE</include>
                    <include>NOTICE</include>
                  </includes>
                </resource>
                <resource>
                  <directory>${project.build.directory}</directory>
                  <includes>
                    <include>quarkus-app/**</include>
                  </includes>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <!-- mvn install: the new image replaces the running container. In this order: a failed build of the image
             leaves the old container running. -->
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <configuration>
          <executable>docker</executable>
          <skip>${docker.skip}</skip>
        </configuration>
        <executions>
          <execution>
            <id>docker-build</id>
            <phase>install</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <arguments>
                <argument>build</argument>
                <argument>-t</argument>
                <argument>${docker.image}</argument>
                <argument>${project.build.directory}/docker</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>docker-remove</id>
            <phase>install</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <arguments>
                <argument>rm</argument>
                <argument>-f</argument>
                <argument>${docker.container}</argument>
              </arguments>
              <!-- no container of that name yet: older Docker versions answer 1 -->
              <successCodes>
                <successCode>0</successCode>
                <successCode>1</successCode>
              </successCodes>
            </configuration>
          </execution>
          <execution>
            <id>docker-run</id>
            <phase>install</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <arguments>
                <argument>run</argument>
                <argument>-d</argument>
                <argument>--name</argument>
                <argument>${docker.container}</argument>
                <argument>-p</argument>
                <argument>${docker.port}:8080</argument>
                <argument>--restart</argument>
                <argument>unless-stopped</argument>
                <argument>-e</argument>
                <argument>RULE_ENGINE_API_KEY=${docker.api-key}</argument>
                <argument>${docker.image}</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${compiler-plugin.version}</version>
        <configuration>
          <parameters>true</parameters>
          <testIncludes>
            <testInclude>com/axonivy/utils/rule/engine/runtime/**</testInclude>
            <testInclude>ch/ivyteam/**</testInclude>
            <!-- of the connector: plain Java, without any Axon Ivy API -->
            <testInclude>com/axonivy/utils/rule/engine/api/**</testInclude>
            <testInclude>com/axonivy/utils/rule/engine/dmn/generator/**</testInclude>
          </testIncludes>
        </configuration>
      </plugin>
      <plugin>
        <!-- sources of the connector for the tests, limited by the testIncludes of the compiler -->
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <id>add-connector-test-sources</id>
            <phase>generate-test-sources</phase>
            <goals>
              <goal>add-test-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>${connector.sources}</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <!-- puts the KIE DMN editor next to the page /editor/: META-INF/resources/editor/lib/dmn-editor.js -->
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.1.0</version>
        <executions>
          <execution>
            <id>dmn-editor</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <property name="dmn.editor.archive" value="${dmn.editor.cache}/${dmn.editor.file}" />
                <property name="dmn.editor.lib" value="${project.build.outputDirectory}/META-INF/resources/editor/lib" />
                <mkdir dir="${dmn.editor.cache}" />
                <get src="${dmn.editor.url}" dest="${dmn.editor.archive}" skipexisting="true" quiet="true" />
                <checksum file="${dmn.editor.archive}" algorithm="SHA-512" property="${dmn.editor.sha512}"
                  verifyproperty="dmn.editor.verified" />
                <fail message="${dmn.editor.archive} is not the expected DMN editor ${dmn.editor.version}. Delete it and build again.">
                  <condition>
                    <isfalse value="${dmn.editor.verified}" />
                  </condition>
                </fail>
                <untar src="${dmn.editor.archive}" dest="${project.build.directory}/dmn-editor" compression="gzip" />
                <copy file="${project.build.directory}/dmn-editor/package/dist/index.js" tofile="${dmn.editor.lib}/dmn-editor.js" />
                <copy file="${project.build.directory}/dmn-editor/package/dist/index.js.LICENSE.txt" tofile="${dmn.editor.lib}/dmn-editor.js.LICENSE.txt" />
                <copy file="${project.build.directory}/dmn-editor/package/dist/envelope.js.LICENSE.txt" tofile="${dmn.editor.lib}/dmn-editor-envelope.js.LICENSE.txt" />
                <copy file="${project.build.directory}/dmn-editor/package/LICENSE" tofile="${dmn.editor.lib}/LICENSE.txt" />
                <echo file="${dmn.editor.lib}/VERSION.txt">@kie-tools/dmn-editor-standalone ${dmn.editor.version}${line.separator}</echo>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${surefire-plugin.version}</version>
        <configuration>
          <excludedGroups>performance</excludedGroups>
          <systemPropertyVariables>
            <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
            <maven.home>${maven.home}</maven.home>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <!-- mvn test -Pperformance : runs the performance baseline (decision table with 1,000 rules) -->
      <id>performance</id>
      <build>
        <plugins>
          <plugin>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <excludedGroups combine.self="override" />
              <groups>performance</groups>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
