<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.axonivy.ivy.api</groupId>
    <artifactId>ivy-project-parent</artifactId>
    <version>14.0.1</version>
    <relativePath />
  </parent>
  <groupId>com.axonivy.utils.ruleengine</groupId>
  <artifactId>rule-engine</artifactId>
  <version>14.0.1-SNAPSHOT</version>
  <packaging>iar</packaging>

  <properties>
    <!-- The standalone build of the Apache KIE DMN editor, same KIE release as the DMN engine container. Not on Maven
         Central, so the build takes it from npm, checks it and keeps it in the local Maven repository. -->
    <dmn.editor.version>10.2.0</dmn.editor.version>
    <dmn.editor.sha512>074a68624f010ac3a7f67e8dd0313dc79e9bd8b2f47f814bb26ace7f9f77974e99339e070e8ce0e4458472104cbe291e86ab4e94cbb915de9fe3fbb5c5e73884</dmn.editor.sha512>
    <dmn.editor.file>dmn-editor-standalone-${dmn.editor.version}.tgz</dmn.editor.file>
    <dmn.editor.url>https://registry.npmjs.org/@kie-tools/dmn-editor-standalone/-/${dmn.editor.file}</dmn.editor.url>
    <dmn.editor.cache>${settings.localRepository}/.cache/kie-tools</dmn.editor.cache>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.axonivy.ivy.api</groupId>
      <artifactId>ivy-api</artifactId>
    </dependency>
    <dependency>
      <groupId>com.axonivy.ivy.api.extension</groupId>
      <artifactId>ivy-process-extension-api</artifactId>
    </dependency>
    <dependency>
      <groupId>com.axonivy.ivy.api.extension</groupId>
      <artifactId>ivy-java-extension-api</artifactId>
    </dependency>
  </dependencies>
  <repositories>
    <repository>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
      <id>central</id>
      <url>https://repo.maven.apache.org/maven2</url>
    </repository>
    <repository>
      <id>maven.axonivy.com</id>
      <url>https://maven.axonivy.com</url>
    </repository>
  </repositories>
  <pluginRepositories>
    <pluginRepository>
      <id>maven.axonivy.com</id>
      <url>https://maven.axonivy.com</url>
    </pluginRepository>
  </pluginRepositories>
  <build>
    <plugins>
      <plugin>
        <groupId>com.axonivy.ivy.ci</groupId>
        <artifactId>project-build-plugin</artifactId>
        <version>14.0.1</version>
      </plugin>
      <plugin>
        <!-- puts the KIE DMN editor on the class path, next to the page of the editor: see DmnEditor -->
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.1.0</version>
        <executions>
          <execution>
            <id>dmn-editor</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <property name="dmn.editor.archive" value="${dmn.editor.cache}/${dmn.editor.file}" />
                <property name="dmn.editor.lib" value="${project.build.outputDirectory}/com/axonivy/utils/rule/engine/editor/lib" />
                <mkdir dir="${dmn.editor.cache}" />
                <get src="${dmn.editor.url}" dest="${dmn.editor.archive}" skipexisting="true" quiet="true" />
                <checksum file="${dmn.editor.archive}" algorithm="SHA-512" property="${dmn.editor.sha512}"
                  verifyproperty="dmn.editor.verified" />
                <fail message="${dmn.editor.archive} is not the expected DMN editor ${dmn.editor.version}. Delete it and build again.">
                  <condition>
                    <isfalse value="${dmn.editor.verified}" />
                  </condition>
                </fail>
                <untar src="${dmn.editor.archive}" dest="${project.build.directory}/dmn-editor" compression="gzip" />
                <copy file="${project.build.directory}/dmn-editor/package/dist/index.js" tofile="${dmn.editor.lib}/dmn-editor.js" />
                <copy file="${project.build.directory}/dmn-editor/package/dist/index.js.LICENSE.txt" tofile="${dmn.editor.lib}/dmn-editor.js.LICENSE.txt" />
                <copy file="${project.build.directory}/dmn-editor/package/dist/envelope.js.LICENSE.txt" tofile="${dmn.editor.lib}/dmn-editor-envelope.js.LICENSE.txt" />
                <copy file="${project.build.directory}/dmn-editor/package/LICENSE" tofile="${dmn.editor.lib}/LICENSE.txt" />
                <echo file="${dmn.editor.lib}/VERSION.txt">@kie-tools/dmn-editor-standalone ${dmn.editor.version}${line.separator}</echo>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
